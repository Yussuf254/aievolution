# ============================================================
# Namwonja Heritage Journal - Backend Environment Variables
# Copy this file to `.env` and fill in your real values.
# For Vercel, add these in: Project Settings -> Environment Variables
# ============================================================

# ---- Supabase (Database) ----
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Service role key (server-side only, NEVER expose to the browser)
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Safaricom Daraja (M-Pesa) ----
# Get these at https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=YOUR-CONSUMER-KEY
MPESA_CONSUMER_SECRET=YOUR-CONSUMER-SECRET
# Passkey from the Daraja portal (sandbox -> Lipa Na M-Pesa Online)
MPESA_PASSKEY=YOUR-PASSKEY
# Shortcode: 174379 (sandbox) or your production Paybill
MPESA_SHORTCODE=174379
# "sandbox" for testing, "production" or "live" for live
MPESA_ENV=live
# Callback URL (must be publicly reachable, e.g. https://yourdomain.vercel.app/api/mpesa-callback)
MPESA_CALLBACK_URL=https://YOURDOMAIN.vercel.app/api/mpesa-callback

# ---- Admin login ----
# Used to sign in to /admin.html
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
